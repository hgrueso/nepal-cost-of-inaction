# =============================================================================
# 04_slides_figures.R — Policy-ready figures for revealjs deck
# Builds: gender-gap descriptives + intersectionality + CoI in absolute terms
# =============================================================================
suppressPackageStartupMessages({
  library(tidyverse); library(srvyr); library(scales); library(patchwork)
})
load("outputs/cleaned_data_v2.RData")
load("outputs/causal_forest_results.RData")
load("outputs/regression_results_v2.RData")

FIGS   <- "outputs/figures"; TABLES <- "outputs/tables"
dir.create(FIGS, showWarnings=FALSE, recursive=TRUE)
dir.create(TABLES, showWarnings=FALSE, recursive=TRUE)

# UNICEF palette
ub<-"#1CABE2"; ud<-"#00377C"; ug<-"#00833D"; ur<-"#E2231A"; ugr<-"#6C7279"

th_policy <- function(b=12) theme_minimal(base_size=b) + theme(
  plot.title=element_text(face="bold", size=b+2, colour="#222"),
  plot.subtitle=element_text(size=b, colour=ugr),
  plot.caption=element_text(size=b-3, colour=ugr, hjust=0),
  axis.title=element_text(size=b, colour="#333"),
  axis.text=element_text(size=b-1, colour="#333"),
  panel.grid.minor=element_blank(),
  panel.grid.major.y=element_line(colour="#EBEBEB", linewidth=0.4),
  panel.grid.major.x=element_blank(),
  legend.position="bottom", legend.text=element_text(size=b-1),
  strip.text=element_text(face="bold", size=b))

sv <- function(p, n, w=10, h=5.5) {
  ggsave(file.path(FIGS, paste0(n, ".png")), p, width=w, height=h, dpi=300, bg="white")
  cat("  ✓", n, "\n")
}

make_svy <- function(d) srvyr::as_survey_design(
  d %>% filter(!is.na(ind_wt), !is.na(province_num)),
  ids=psu_number, strata=province_num, weights=ind_wt, nest=TRUE)
svy_b <- make_svy(df_b)

# =============================================================================
# FIG D1 — Overall gender gap: enrolment, secondary, employment, NEET
# =============================================================================
cat("\n=== D1: Overall gender gap (4 outcomes) ===\n")

gap_overall <- svy_b %>% group_by(sex_lbl) %>%
  summarise(
    Enrolled = survey_mean(attend_any==1, vartype="ci")*100,
    Secondary = survey_mean(in_secondary==1, vartype="ci")*100,
    Employed = survey_mean(employed_ilo==1, na.rm=TRUE, vartype="ci")*100,
    NEET     = survey_mean(neet==1, na.rm=TRUE, vartype="ci")*100,
    .groups="drop") %>% filter(!is.na(sex_lbl))

make_long <- function(d, base) {
  d %>% select(sex_lbl, value=all_of(base),
               lo=paste0(base,"_low"), hi=paste0(base,"_upp")) %>%
    mutate(outcome=base)
}
g_long <- bind_rows(
  make_long(gap_overall,"Enrolled"),
  make_long(gap_overall,"Secondary"),
  make_long(gap_overall,"Employed"),
  make_long(gap_overall,"NEET")
) %>% mutate(outcome=factor(outcome, c("Enrolled","Secondary","Employed","NEET")))

figD1 <- ggplot(g_long, aes(x=outcome, y=value, fill=sex_lbl)) +
  geom_col(position=position_dodge(0.7), width=0.6, alpha=0.92) +
  geom_errorbar(aes(ymin=lo, ymax=hi), position=position_dodge(0.7),
                width=0.18, linewidth=0.4) +
  geom_text(aes(label=paste0(round(value,0),"%"), y=hi+1.5),
            position=position_dodge(0.7), size=4.2, fontface="bold") +
  scale_fill_manual(values=c("Male"=ud,"Female"=ub), name=NULL) +
  scale_y_continuous(labels=label_percent(scale=1),
                     expand=expansion(mult=c(0,0.18))) +
  labs(title="Girls enrol more, work less, and end up NEET twice as often",
       subtitle="Survey-weighted estimates for youth aged 15-24 | NLSS IV 2022/23",
       x=NULL, y="% of youth 15-24",
       caption="The gender gap is not in schools — it is in labour markets after schools.")+
  th_policy()
sv(figD1, "d1_overall_gap", w=11, h=5.5)

# =============================================================================
# FIG D2 — NEET rate by province × sex (girls always worse)
# =============================================================================
cat("\n=== D2: NEET by province × sex ===\n")
neet_prov <- svy_b %>% group_by(province_lbl, sex_lbl) %>%
  summarise(pct=survey_mean(neet==1, na.rm=TRUE, vartype="ci")*100, .groups="drop") %>%
  filter(!is.na(province_lbl), !is.na(sex_lbl))

figD2 <- ggplot(neet_prov,
  aes(x=reorder(as.character(province_lbl), pct), y=pct, fill=sex_lbl)) +
  geom_col(position=position_dodge(0.72), width=0.65, alpha=0.92) +
  geom_errorbar(aes(ymin=pct_low, ymax=pct_upp), position=position_dodge(0.72),
                width=0.18, linewidth=0.4) +
  geom_text(aes(label=paste0(round(pct,0),"%"), y=pct_upp+1),
            position=position_dodge(0.72), size=3.2, hjust=-0.1) +
  scale_fill_manual(values=c("Male"=ud,"Female"=ub), name=NULL) +
  scale_y_continuous(labels=label_percent(scale=1), expand=expansion(mult=c(0,0.18))) +
  coord_flip() +
  labs(title="Madhesh and Lumbini are crisis zones for girls",
       subtitle="Female NEET rate exceeds male in every province | Youth 15-24",
       x=NULL, y="% NEET",
       caption="The gap is largest in the Terai (Madhesh, Lumbini) and smallest in Bagmati.")+
  th_policy()
sv(figD2, "d2_neet_by_province", w=11, h=5.5)

# =============================================================================
# FIG D3 — Intersectionality: caste × married × rural (girls only)
# =============================================================================
cat("\n=== D3: Intersectionality ===\n")
intersect_data <- df_girls %>%
  filter(!is.na(caste_broad), caste_broad %in% c("Dalit","Brahmin/Chhetri","Janajati","Religious/Linguistic"),
         !is.na(currently_married), !is.na(rural)) %>%
  mutate(profile = case_when(
    currently_married==1 & rural==1 ~ "Married + Rural",
    currently_married==1 & rural==0 ~ "Married + Urban",
    currently_married==0 & rural==1 ~ "Unmarried + Rural",
    currently_married==0 & rural==0 ~ "Unmarried + Urban"
  )) %>%
  group_by(caste_broad, profile) %>%
  summarise(neet=mean(neet, na.rm=TRUE)*100, n=n(), .groups="drop") %>%
  filter(n >= 15, !is.na(profile))

figD3 <- ggplot(intersect_data,
  aes(x=profile, y=neet, fill=caste_broad)) +
  geom_col(position=position_dodge(0.75), width=0.65, alpha=0.92) +
  geom_text(aes(label=paste0(round(neet,0),"%"), y=neet+1.5),
            position=position_dodge(0.75), size=3, fontface="bold") +
  scale_fill_manual(values=c("Dalit"=ur,"Brahmin/Chhetri"=ud,
                              "Janajati"=ug,"Religious/Linguistic"="#9467BD"),
                    name="Caste/Ethnicity") +
  scale_y_continuous(labels=label_percent(scale=1), expand=expansion(mult=c(0,0.15))) +
  labs(title="Dalit + Married + Rural: the highest exclusion in Nepal",
       subtitle="Compound disadvantage by caste, marriage and location | Girls 15-24",
       x=NULL, y="% NEET",
       caption="Cells with n<15 dropped. Religious/Linguistic concentrated in Madhesh/Lumbini.")+
  th_policy() + theme(axis.text.x=element_text(angle=20, hjust=1, size=10))
sv(figD3, "d3_intersectionality", w=12, h=5.5)

# =============================================================================
# FIG R1 — Main coefficient plot (regression results in pp)
# =============================================================================
cat("\n=== R1: Main coefficients in pp ===\n")
library(broom); library(fixest)

coef_data <- bind_rows(
  tidy(reg_results_v2$m1$full, conf.int=TRUE) %>% mutate(outcome="Enrolment\n(Girls 15-24)"),
  tidy(reg_results_v2$m2$full, conf.int=TRUE) %>% mutate(outcome="NEET\n(Youth 15-24)")
) %>%
  filter(term %in% c("female","rural","ppoor","quintile_n","currently_married",
                      "any_difficulty","caste_broadDalit","caste_broadJanajati",
                      "caste_broadReligious/Linguistic")) %>%
  mutate(
    term_lbl = recode(term,
      "female"="Female","rural"="Rural","ppoor"="Below poverty line",
      "quintile_n"="Per wealth quintile step",
      "currently_married"="Currently married",
      "any_difficulty"="Disability",
      "caste_broadDalit"="Dalit",
      "caste_broadJanajati"="Janajati",
      "caste_broadReligious/Linguistic"="Religious/Linguistic"),
    sig = case_when(p.value<0.01~"***", p.value<0.05~"**",
                    p.value<0.10~"*", TRUE~""),
    estimate_pp = estimate*100,
    lo_pp = conf.low*100,
    hi_pp = conf.high*100,
    lbl = paste0(ifelse(estimate_pp>0,"+",""), round(estimate_pp,1), " pp", sig)
  )

figR1 <- ggplot(coef_data,
    aes(x=estimate_pp, xmin=lo_pp, xmax=hi_pp,
        y=reorder(term_lbl, abs(estimate_pp)))) +
  geom_vline(xintercept=0, linetype="dashed", colour="grey50") +
  geom_errorbarh(height=0.3, linewidth=0.5, colour=ugr) +
  geom_point(aes(colour=ifelse(estimate_pp>0, ur, ud)), size=3, alpha=0.85) +
  geom_text(aes(label=lbl, x=hi_pp+5), hjust=0, size=3.2, fontface="bold") +
  scale_colour_identity() +
  scale_x_continuous(labels=label_number(suffix=" pp"),
                     expand=expansion(mult=c(0.05, 0.30))) +
  facet_wrap(~outcome, scales="free_y", ncol=2) +
  labs(title="Marriage is by far the strongest barrier to girls' inclusion",
       subtitle="Linear probability model with province fixed effects | All coefficients in pp",
       x="Effect on outcome (pp)", y=NULL,
       caption="Reference: Brahmin/Chhetri, urban, non-poor. Stars: *p<0.10, **p<0.05, ***p<0.01. Full models in appendix.")+
  th_policy() + theme(panel.grid.major.y=element_blank())
sv(figR1, "r1_coef_pp", w=13, h=5.5)

# =============================================================================
# FIG R2 — Causal forest CATE: who benefits most from secondary education?
# =============================================================================
cat("\n=== R2: CATE ===\n")
cate_caste <- cf_results$cate_neet_all %>%
  filter(dimension=="Caste/Ethnicity", group != "Other") %>%
  mutate(group=as.character(group))

cate_caste <- cate_caste %>%
  mutate(group = factor(as.character(group),
                        levels = as.character(group)[order(mean_cate)]))

figR2 <- ggplot(cate_caste,
    aes(x=mean_cate*100, y=group)) +
  geom_vline(xintercept=0, linetype="dashed", colour="grey50") +
  geom_vline(xintercept=-13.2, linetype="dotted", colour="#333") +
  geom_errorbarh(aes(xmin=ci_lo*100, xmax=ci_hi*100),
                 height=0.3, linewidth=0.6, colour=ur) +
  geom_point(size=4, colour=ur, alpha=0.88) +
  geom_text(aes(label=paste0(round(mean_cate*100,1)," pp"), x=ci_hi*100+0.3),
            hjust=0, size=3.5, fontface="bold") +
  annotate("text", x=-13.2, y=0.55, label="ATE = -13.2 pp",
           hjust=0, vjust=0, size=3, colour="#333", fontface="italic") +
  scale_x_continuous(labels=label_number(suffix=" pp"),
                     expand=expansion(mult=c(0.05, 0.25))) +
  labs(title="Secondary education reduces NEET by ~13 pp — for every caste",
       subtitle="Causal forest CATE | Women 15-64 | Negative = education works",
       x="Reduction in NEET probability (pp)", y=NULL,
       caption="Effects stable across groups. Dalit women benefit ~2 pp less due to persistent labour market discrimination.")+
  th_policy()
sv(figR2, "r2_cate_caste", w=11, h=5)

# =============================================================================
# COI CALCULATION — STRIKING POLICY NUMBERS
# =============================================================================
cat("\n=== COI: Striking numbers ===\n")

# Use hardcoded median wages by province (consistent with main analysis)
prov_data <- tribble(
  ~province_lbl,    ~base_wage, ~gdp_nprb,
  "Bagmati",         7000,       2074,
  "Koshi",           2500,        903,
  "Gandaki",         2292,        517,
  "Madhesh",         2000,        748,
  "Lumbini",         1500,        814,
  "Karnali",         1066,        244,
  "Sudurpashchim",   1042,        404
)

# Population of girls 15-24 not completing secondary, per province
pop_excluded <- df_girls %>%
  filter(!is.na(province_lbl)) %>%
  group_by(province_lbl) %>%
  summarise(
    total_wt = sum(ind_wt, na.rm=TRUE),
    pct_no_sec = mean(completed_secondary==0, na.rm=TRUE),
    .groups="drop") %>%
  mutate(province_lbl=as.character(province_lbl),
         pop_share = total_wt/sum(total_wt),
         pop_girls = round(1.4e6 * pop_share),
         n_excluded = round(pop_girls * pct_no_sec))

# CATE per province
cate_prov <- cf_results$cate_neet_all %>%
  filter(dimension=="Province") %>%
  mutate(province_lbl=as.character(group), cate_abs=abs(mean_cate))

coi <- pop_excluded %>%
  left_join(prov_data, by="province_lbl") %>%
  left_join(cate_prov %>% select(province_lbl, cate_abs), by="province_lbl") %>%
  mutate(
    # PV per girl: monthly wage × 12 × ((1+r)^Δs - 1) × annuity
    pv_per_girl = base_wage * 12 * ((1.09)^2 - 1) * (1 - 1.05^(-35)) / 0.05,
    # Wage-months equivalent per girl (intuitive metric)
    wage_months_lost = pv_per_girl / base_wage,
    # CoI per 100 girls (NPR thousand)
    coi_per_100k = cate_abs * 100 * pv_per_girl / 1000,
    # Total provincial CoI (NPR billion)
    total_coi_b  = cate_abs * n_excluded * pv_per_girl / 1e9,
    # As share of provincial GDP
    coi_pct_gdp  = total_coi_b / gdp_nprb * 100
  )

national_coi_b <- sum(coi$total_coi_b, na.rm=TRUE)
national_coi_usd_m <- national_coi_b * 1000 / 133 # ~133 NPR/USD
national_excluded <- sum(coi$n_excluded, na.rm=TRUE)

cat(sprintf("NATIONAL CoI: NPR %.1f billion (~USD %.0f million)\n",
            national_coi_b, national_coi_usd_m))
cat(sprintf("Girls affected: %s\n", format(national_excluded, big.mark=",")))
cat(sprintf("Avg CoI per girl: NPR %s\n",
            format(round(national_coi_b*1e9/national_excluded), big.mark=",")))

readr::write_csv(coi, file.path(TABLES, "coi_full.csv"))

# ── C1 — Striking aggregate: NPR billion total by province ────────────────────
cat("\n--- C1: Total CoI ---\n")
figC1 <- ggplot(coi %>% filter(!is.na(total_coi_b)),
    aes(x=reorder(province_lbl, total_coi_b), y=total_coi_b)) +
  geom_col(aes(fill=ifelse(province_lbl %in% c("Karnali","Sudurpashchim","Madhesh"),
                            ur, ud)), alpha=0.9, width=0.65) +
  geom_text(aes(label=paste0("NPR ", round(total_coi_b,1),"B"), y=total_coi_b+0.15),
            hjust=0, size=3.8, fontface="bold") +
  scale_fill_identity() +
  scale_y_continuous(labels=label_number(suffix="B", scale=1),
                     expand=expansion(mult=c(0,0.30))) +
  coord_flip() +
  labs(title=paste0("Nepal forgoes NPR ", round(national_coi_b,1),
                     " billion (~USD ", round(national_coi_usd_m), "M) by not educating its adolescent girls"),
       subtitle=paste0("Total lifetime productivity loss across ",
                        format(national_excluded, big.mark=","),
                        " girls aged 15-24 without secondary completion"),
       x=NULL, y="Cost of Inaction (NPR Billion)",
       caption="Red = highest-burden provinces. ILO 9% return per year of schooling, 35-year horizon, 5% discount rate.")+
  th_policy()
sv(figC1, "c1_total_coi_billion", w=12, h=5.5)

# ── C2 — Wage-months equivalent per girl ──────────────────────────────────────
cat("\n--- C2: Wage months lost ---\n")
months_lost_avg <- coi %>%
  summarise(wm = weighted.mean(wage_months_lost, w=n_excluded, na.rm=TRUE)) %>%
  pull(wm)

# Per girl: months of median wage lost, by province
figC2 <- ggplot(coi %>% filter(!is.na(wage_months_lost)),
    aes(x=reorder(province_lbl, wage_months_lost), y=wage_months_lost)) +
  geom_col(fill=ud, alpha=0.88, width=0.65) +
  geom_text(aes(label=paste0(round(wage_months_lost), " months"), y=wage_months_lost+1),
            hjust=0, size=3.8, fontface="bold") +
  scale_y_continuous(expand=expansion(mult=c(0,0.20))) +
  coord_flip() +
  labs(title="Each excluded girl loses ~51 months of her own wages over her lifetime",
       subtitle="Wage-months of lost lifetime earnings per girl not completing secondary | By province",
       x=NULL, y="Months of median provincial wage forgone (per girl)",
       caption="Equivalent to ~4 years of monthly income at the local median wage. Computed as PV foregone earnings / median monthly wage.")+
  th_policy()
sv(figC2, "c2_wage_months", w=12, h=5)

# ── C3 — Comparison: aggregate CoI vs benchmarks ──────────────────────────────
cat("\n--- C3: CoI vs benchmarks ---\n")
# Nepal national budget 2024/25: ~NPR 1,860 billion (Ministry of Finance)
# Education sector budget: ~NPR 197 billion (10.6% of total)
# Health sector budget: ~NPR 84 billion
benchmarks <- tribble(
  ~item,                                    ~value_b, ~lbl,
  "Annual Cost of Inaction\n(adolescent girls)", national_coi_b, paste0("NPR ", round(national_coi_b,1),"B"),
  "Nepal Health Sector budget\n(2024/25)",     84,    "NPR 84B",
  "Nepal Education Sector budget\n(2024/25)", 197,    "NPR 197B"
) %>%
  mutate(item=factor(item, levels=item))

figC3 <- ggplot(benchmarks, aes(x=item, y=value_b)) +
  geom_col(aes(fill=ifelse(grepl("Inaction", item), ur, ud)),
           alpha=0.9, width=0.55) +
  geom_text(aes(label=lbl, y=value_b+5), size=4.5, fontface="bold") +
  scale_fill_identity() +
  scale_y_continuous(labels=label_number(suffix="B", scale=1),
                     expand=expansion(mult=c(0,0.20))) +
  labs(title=paste0("Nepal's cost of inaction = ", round(national_coi_b/84*100),
                     "% of the annual health budget"),
       subtitle="Lifetime productivity loss from one cohort of girls without secondary education",
       x=NULL, y="NPR Billion",
       caption="National budget figures: Ministry of Finance, Nepal (2024/25 fiscal year). CoI is one-time estimate per cohort.")+
  th_policy() + theme(axis.text.x=element_text(size=11))
sv(figC3, "c3_coi_vs_budget", w=11, h=5.5)

# Save summary numbers for slide use
summary_nums <- list(
  national_coi_b = round(national_coi_b, 1),
  national_coi_usd_m = round(national_coi_usd_m),
  national_excluded = national_excluded,
  months_lost_avg = round(months_lost_avg),
  coi_pct_health_budget = round(national_coi_b/84*100),
  coi_pct_education_budget = round(national_coi_b/197*100)
)
saveRDS(summary_nums, "outputs/coi_summary_numbers.RData")
cat("\n=== KEY SUMMARY NUMBERS ===\n")
print(summary_nums)

cat("\n✓ All figures ready in outputs/figures/\n")

# =============================================================================
# REBUILD D3 — Religious/Linguistic is actually highest, so reframe accurately
# Also: center "Married + Rural" properly
# =============================================================================
cat("\n=== Rebuild D3 (correct narrative) ===\n")

# Order x-axis from worst to best
intersect_data2 <- df_girls %>%
  filter(!is.na(caste_broad), caste_broad %in% c("Dalit","Brahmin/Chhetri","Janajati","Religious/Linguistic"),
         !is.na(currently_married), !is.na(rural)) %>%
  mutate(profile = case_when(
    currently_married==1 & rural==1 ~ "Married + Rural",
    currently_married==1 & rural==0 ~ "Married + Urban",
    currently_married==0 & rural==1 ~ "Unmarried + Rural",
    currently_married==0 & rural==0 ~ "Unmarried + Urban"
  )) %>%
  group_by(caste_broad, profile) %>%
  summarise(neet=mean(neet, na.rm=TRUE)*100, n=n(), .groups="drop") %>%
  filter(n >= 15, !is.na(profile)) %>%
  mutate(profile=factor(profile, c("Married + Rural","Married + Urban",
                                     "Unmarried + Rural","Unmarried + Urban")),
         caste_broad=factor(caste_broad, c("Religious/Linguistic","Dalit","Janajati","Brahmin/Chhetri")))

figD3 <- ggplot(intersect_data2,
  aes(x=profile, y=neet, fill=caste_broad)) +
  geom_col(position=position_dodge(0.75, preserve="single"),
           width=0.65, alpha=0.92) +
  geom_text(aes(label=paste0(round(neet,0),"%"), y=neet+1.5),
            position=position_dodge(0.75, preserve="single"),
            size=3, fontface="bold") +
  scale_fill_manual(values=c("Religious/Linguistic"="#9467BD",
                              "Dalit"="#E2231A",
                              "Janajati"="#00833D",
                              "Brahmin/Chhetri"="#00377C"),
                    name="Caste/Ethnicity") +
  scale_y_continuous(labels=label_percent(scale=1), expand=expansion(mult=c(0,0.15))) +
  labs(title="Married + Rural: nearly universal NEET, regardless of caste",
       subtitle="Marriage is the dominant driver; Religious/Linguistic concentration in Madhesh worsens all profiles",
       x=NULL, y="% NEET",
       caption="Cells with n<15 dropped. Religious/Linguistic mainly Terai Muslim and hill Janajati communities.")+
  th_policy() + th